| replhelp - help table of r3repl: base words and REPL commands
| each record: "name" "library" "stack effect" "description"
| the list ends with a 0 byte; e.lib / e.eff / e.next walk the records
| (library words come from r3/d4/meta/mlibs.r3, generated by metabuild)

##btab
"dup" "base" "a -- a a" "duplicate the top"
"drop" "base" "a --" "drop the top"
"swap" "base" "a b -- b a" "swap the top two"
"over" "base" "a b -- a b a" "copy the second"
"rot" "base" "a b c -- b c a" "rotate three"
"-rot" "base" "a b c -- c a b" "rotate three backwards"
"nip" "base" "a b -- b" "drop the second"
"pick2" "base" "a b c -- a b c a" "copy the third"
"pick3" "base" "a b c d -- a b c d a" "copy the fourth"
"2dup" "base" "a b -- a b a b" "duplicate the pair"
"2drop" "base" "a b --" "drop the pair"
"2swap" "base" "a b c d -- c d a b" "swap pairs"
"3drop" "base" "a b c --" "drop three"
"+" "base" "a b -- c" "add"
"-" "base" "a b -- c" "subtract"
"*" "base" "a b -- c" "multiply"
"/" "base" "a b -- c" "integer division"
"mod" "base" "a b -- c" "remainder"
"/mod" "base" "a b -- m q" "remainder and quotient"
"*/" "base" "a b c -- d" "a*b/c"
"and" "base" "a b -- c" "bitwise and"
"or" "base" "a b -- c" "bitwise or"
"xor" "base" "a b -- c" "bitwise xor"
"not" "base" "a -- b" "complement"
"<<" "base" "a n -- b" "shift left"
">>" "base" "a n -- b" "shift right"
"neg" "base" "a -- b" "negate"
"abs" "base" "a -- b" "absolute value"
"sqrt" "base" "a -- b" "integer square root"
"@" "base" "adr -- v" "read 64 bits"
"!" "base" "v adr --" "write 64 bits"
"c@" "base" "adr -- c" "read a byte"
"c!" "base" "c adr --" "write a byte"
"+!" "base" "v adr --" "add to memory"
"/help" "cmd" "" "command help"
"/words" "cmd" "[txt]" "search words in libraries"
"/lib" "cmd" "word" "library to include"
"/save" "cmd" "" "save the project"
"/new" "cmd" "name" "new (empty) project"
"/load" "cmd" "name" "open a project (no name: list)"
"/proj" "cmd" "" "list projects"
"/open" "cmd" "file" "new project from a code in r3/"
"/find" "cmd" "text" "search codes in r3/"
"/edit" "cmd" "" "edit the project (r3ide)"
"/run" "cmd" "" "launch the project"
"/init" "cmd" "[code|off]" "hook run before each line (repl-init)"
"/done" "cmd" "[code|off]" "hook run after each line (repl-done)"
"/stack" "cmd" "" "show the stack"
"/fmt" "cmd" "[dec|hex|fix]" "stack format"
"/term" "cmd" "" "output terminal of the last run"
"/src" "cmd" "" "show the generated program"
"/clear" "cmd" "" "clear the history"
"/reset" "cmd" "" "clear the stack"
"/exit" "cmd" "" "quit"
".rs" "repl" "--" "print the stack, keep it (REPL runs only)"
( 0 )

::e.lib >>0 ;                  | record -- library
::e.eff >>0 >>0 ;              | record -- stack effect
::e.next >>0 >>0 >>0 >>0 ;     | record -- next record
