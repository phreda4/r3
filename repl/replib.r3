| replib - word search for r3repl
| base words: r3map.r3 (r3base + r3ainfo)  libraries: meta/mlibs.r3 (generated by metabuild)
| scanwords calls 'vec once per word with cw=word cl=library ce=effect
| 'vec returns 0 to continue, 1 to stop
^r3/lib/mem.r3
^r3/lib/str.r3
^r3/d4/r3map.r3
^r3/d4/meta/mlibs.r3

##cw 0 ##cl 0 ##ce 0
#xvec 0 #xwd 0 #xin 0 #stp 0 #fxs 0
#sbase "base"
#efb * 64

|--- effect: use<<8 | delta&$ff ; -1 = data
:infoeff | info -- eff ; mlibs info = $80 data | use<<4 | delta (4 bits, signed)
	$80 and? ( drop -1 ; )
	dup 4 >> 7 and swap $f and 60 << 60 >> $ff and swap 8 << or ;

:baseeff | idx -- eff ; idx in r3base
	7 + r3ainfo dup c@ $ff and swap 1+ c@ $ff and swap 8 << or ;

::effstr | eff -- 'str ; "in -> out"
	-? ( drop "data" ; )
	dup 8 >> swap $ff and 56 << 56 >> over +
	swap "%d -> %d" sprint 'efb strcpy 'efb ;

|--- base words, lowercase copy of r3map's list
#bpool * 2048
#bn 0
:baseinit
	bn 1? ( drop ; ) drop
	'bpool >a
	0 ( dup basename c@ $ff and 1? drop
		dup basename ( c@+ $ff and 1? tolow ca!+ ) 2drop
		0 ca!+
		1+ ) drop
	0 ca!+
	1 'bn ! ;

:scanbase
	baseinit
	'bpool 0
	( stp 0? drop over c@ $ff and 1? drop
		over 'cw ! dup baseeff 'ce ! 'sbase 'cl !
		xvec ex 'stp !
		swap >>0 swap 1+ )
	3drop ;

|--- libraries (the win/ ones do not apply)
:winlib? | -- 0/1
	cl "/win/" findstr 0? ( ; ) drop 1 ;

:scanlibs
	'liblist
	( stp 0? drop @+ 1?
		dup @ 'cl !
		dup 8 + @ 'xwd !
		16 + @ 'xin !
		winlib? 0? ( drop
			( stp 0? drop xwd c@ $ff and 1? drop
				xin c@ $ff and infoeff 'ce ! xwd 'cw !
				xvec ex 'stp !
				xwd >>0 'xwd ! 1 'xin +! ) ) drop )
	2drop ;

::scanwords | 'vec -- stop
	'xvec ! 0 'stp !
	scanbase scanlibs stp ;

|--- queries on the current word (use inside 'vec)
::wis | 'str -- 0/1 ; cw = str
	cw = ;

::wpre | 'str -- 0/1 ; cw starts with str
	cw swap =pre nip 1? ( drop 1 ; ) ;

::wsub | 'str -- 0/1 ; cw contains str
	cw swap findstri 1? ( drop 1 ; ) ;

|--- exact lookup: 0 not found, 1 base, 2 library ; sets cw cl ce
:m.exact | -- stop
	fxs wis ;

::wfind | 'str -- 0/1/2
	dup ?base 1? ( 1- baseeff 'ce ! 'cw ! 'sbase 'cl ! 1 ; ) drop
	'fxs ! 'm.exact 'xvec ! 0 'stp !
	scanlibs stp 1? ( drop 2 ; ) ;
