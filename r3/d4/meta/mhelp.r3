; d = (a*b)>>c (no overflow)" "a b c -- d ; d = (a<<c)/b (no overflow)" "a -- b ; b = NOT a (all bits flipped)" "a -- b ; b = -a" "a -- b ; b = absolute value of a" "a -- b ; b = integer square root of a" "a -- b ; b = count leading zeros of a" "a -- [a] ; fetch qword" "a -- byte[a] ; fetch byte" "a -- word[a] ; fetch word" "a -- dword[a] ; fetch dword" "a -- b [a] ; fetch qword and increment" "a -- b byte[a] ; fetch byte and increment" "a -- b word[a] ; fetch word and increment" "a -- b dword[a] ; fetch dword and increment" "a b -- ; store A at address B" "a b -- ; store byte A at address B" "a b -- ; store word A at address B" "a b -- ; store dword A at address B" "a b -- c ; store A at B and increment" "a b -- c ; store byte A at B and increment" "a b -- c ; store word A at B and increment" "a b -- c ; store dword A at B and increment" "a b -- ; add A to value at address B" "a b -- ; add A to byte at address B" "a b -- ; add A to word at address B" "a b -- ; add A to dword at address B" "a -- ; load register A" "-- a ; push register A" "a -- ; add to register A" "-- a ; fetch qword from A" "a -- ; store qword at A" "-- a ; fetch qword from A and increment" "a -- ; store qword at A and increment" "-- a ; fetch byte from A" "a -- ; store byte at A" "-- a ; fetch byte from A and increment" "a -- ; store byte at A and increment" "-- a ; fetch dword from A" "a -- ; store dword at A" "-- a ; fetch dword from A and increment" "a -- ; store dword at A and increment" "a -- ; load register B" "-- a ; push register B" "a -- ; add to register B" "-- a ; fetch qword from B" "a -- ; store qword at B" "-- a ; fetch qword from B and increment" "a -- ; store qword at B and increment" "-- a ; fetch byte from B" "a -- ; store byte at B" "-- a ; fetch byte from B and increment" "a -- ; store byte at B and increment" "-- a ; fetch dword from B" "a -- ; store dword at B" "-- a ; fetch dword from B and increment" "a -- ; store dword at B and increment" "-- ; save A and B to return stac