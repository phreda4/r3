| r3cf - canonical fragments of the base words ( tier 0 of r3comp3 )
| PHREDA 2026
|---------------------------------------------------------------
| the stack is canonical:  rax = TOS , [rbp] = NOS , [rbp-8] = 3rd ...
| each fragment is written for this state and moves rbp as it needs: r3opt1 folds the
| movements of rbp. ';' separates the instructions , '~' is the label of the jump ( jt ).
| the conditions jump when they fail.
| LOADLIB GETPROC SYS0..SYS10 are in r3comp3 ( they depend on the target )
|---------------------------------------------------------------
##fragcf
"EX" "mov rcx,rax;mov rax,[rbp];sub rbp,8;test rcx,rcx;jz @f;call rcx;@@:"
"0?" "test rax,rax;jnz ~"
"1?" "test rax,rax;jz ~"
"+?" "test rax,rax;js ~"
"-?" "test rax,rax;jns ~"
"<?" "cmp qword[rbp],rax;mov rax,[rbp];sub rbp,8;jge ~"
">?" "cmp qword[rbp],rax;mov rax,[rbp];sub rbp,8;jle ~"
"=?" "cmp qword[rbp],rax;mov rax,[rbp];sub rbp,8;jne ~"
">=?" "cmp qword[rbp],rax;mov rax,[rbp];sub rbp,8;jl ~"
"<=?" "cmp qword[rbp],rax;mov rax,[rbp];sub rbp,8;jg ~"
"<>?" "cmp qword[rbp],rax;mov rax,[rbp];sub rbp,8;je ~"
"AND?" "test qword[rbp],rax;mov rax,[rbp];sub rbp,8;jz ~"
"NAND?" "test qword[rbp],rax;mov rax,[rbp];sub rbp,8;jnz ~"
"IN?" "mov rcx,[rbp-8];sub rcx,[rbp];mov rdx,rax;sub rdx,[rbp];mov rax,[rbp-8];sub rbp,16;cmp rcx,rdx;ja ~"
"DUP" "add rbp,8;mov [rbp],rax"
"DROP" "mov rax,[rbp];sub rbp,8"
"OVER" "add rbp,8;mov [rbp],rax;mov rax,[rbp-8]"
"PICK2" "add rbp,8;mov [rbp],rax;mov rax,[rbp-16]"
"PICK3" "add rbp,8;mov [rbp],rax;mov rax,[rbp-24]"
"PICK4" "add rbp,8;mov [rbp],rax;mov rax,[rbp-32]"
"SWAP" "mov rcx,[rbp];mov [rbp],rax;mov rax,rcx"
"NIP" "sub rbp,8"
"ROT" "mov rcx,[rbp-8];mov rdx,[rbp];mov [rbp-8],rdx;mov [rbp],rax;mov rax,rcx"
"-ROT" "mov rcx,[rbp-8];mov rdx,[rbp];mov [rbp-8],rax;mov [rbp],rcx;mov rax,rdx"
"2DUP" "mov rcx,[rbp];add rbp,16;mov [rbp-8],rax;mov [rbp],rcx"
"2DROP" "mov rax,[rbp-8];sub rbp,16"
"3DROP" "mov rax,[rbp-16];sub rbp,24"
"4DROP" "mov rax,[rbp-24];sub rbp,32"
"2OVER" "mov rcx,[rbp-16];mov rdx,[rbp-8];mov [rbp+8],rax;mov [rbp+16],rcx;add rbp,16;mov rax,rdx"
"2SWAP" "mov rcx,[rbp-16];mov rdx,[rbp-8];mov rsi,[rbp];mov [rbp-16],rsi;mov [rbp-8],rax;mov [rbp],rcx;mov rax,rdx"
">R" "push rax;mov rax,[rbp];sub rbp,8"
"R>" "add rbp,8;mov [rbp],rax;pop rax"
"R@" "add rbp,8;mov [rbp],rax;mov rax,[rsp]"
"AND" "and rax,[rbp];sub rbp,8"
"OR" "or rax,[rbp];sub rbp,8"
"XOR" "xor rax,[rbp];sub rbp,8"
"NAND" "not rax;and rax,[rbp];sub rbp,8"
