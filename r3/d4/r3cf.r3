"/" "mov rcx,rax;mov rax,[rbp];cqo;idiv rcx;sub rbp,8"
"<<" "mov rcx,rax;mov rax,[rbp];shl rax,cl;sub rbp,8"
">>" "mov rcx,rax;mov rax,[rbp];sar rax,cl;sub rbp,8"
">>>" "mov rcx,rax;mov rax,[rbp];shr rax,cl;sub rbp,8"
"MOD" "mov rcx,rax;mov rax,[rbp];cqo;idiv rcx;mov rax,rdx;sub rbp,8"
"/MOD" "mov rcx,rax;mov rax,[rbp];cqo;idiv rcx;mov [rbp],rax;mov rax,rdx"
"*/" "mov rcx,rax;mov rax,[rbp-8];imul qword[rbp];idiv rcx;sub rbp,16"
"*>>" "mov rcx,rax;mov rax,[rbp-8];imul qword[rbp];shrd rax,rdx,cl;sar rdx,cl;and ecx,64;cmovne rax,rdx;sub rbp,16"
"<</" "mov rcx,rax;mov rax,[rbp-8];cqo;shld rdx,rax,cl;shl rax,cl;idiv qword[rbp];sub rbp,16"
