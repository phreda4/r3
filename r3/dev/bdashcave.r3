##ncaves 20

#cavetab 'cave1 'cave2 'cave3 'cave4 'cave5 'cave6 'cave7 'cave8 'cave9 'cave10
         'cave11 'cave12 'cave13 'cave14 'cave15 'cave16 'cave17 'cave18 'cave19 'cave20
		 
#randseed1
#randseed2
	
:nextRandom
	randseed2 dup 2/ $7f and | s1 tmp2
	swap dup 1 and $80 * + | tmp2 res
	dup 8 >> 1 and 			| tmp res carry
	swap $ff and + $13 +	| tmp res
	dup 8 >> 1 and 			| tmp res carry
	swap $ff and 'randseed2 !	| tmp carry
	randseed1 dup 1 and $80 * + + | tmp carry+s0
	dup 8 >> 1 and 				| tmp res crry
	swap $ff and + + 
	$ff and 'randseed1 !			
	;
	
|------------ DECODE
##cave * 960 | 40x24
##cavelast

::cavea | x y -- adr
	40 * + 'cave + ;

::cave! | t x y --
	cavea c! ;

::cave@ | x y -- t
	cavea c@ ;

#ldx (  0   1  1  1  0  -1  -1  -1 )
#ldy ( -1  -1  0  1  1   1   0  -1 )
#dx #dy

:line! | t x y l d --
	dup 'ldx + c@ 'dx ! 'ldy + c@ 'dy !
	( 1? 1- >r
		pick2 pick2 pick2 cave!
		dy + swap dx + swap
		r> ) 4drop	;

#w #h	
:rect! | t x y w h --
	1- 'h ! 1- 'w !
	0 ( w <=? | t x y cnt
		2over pick2 + pick3 cave!
		2over pick2 + pick3 h + cave!
		1+ ) drop
	1 ( h <?
		2over 2over + cave!
		2over w + 2over + cave!
		1+ ) drop
	3drop ;

#o
:fillrect! | t x y W H O --
	'o ! 
	1- 'h ! 1- 'w !
	0 ( w <=? | t x y cnt
		2over pick2 + pick3 cave!
		2over pick2 + pick3 h + cave!
		1+ ) drop
	1 ( h <? | t x y h
		2over 2over + cave!
		o pick3 1+ pick3 pick3 + w 1- 2 line!
		2over w + 2over + cave!
		1+ ) drop
	3drop ;
	
:]acave | a -- n
	a> + c@ ;

:t0
	ca@+ ca@+ cave! ;
:t1
	ca@+ ca@+ ca@+ ca@+ line! ;
:t2
	ca@+ ca@+ ca@+ ca@+ ca@+ fillrect! ;
:t3
	ca@+ ca@+ ca@+ ca@+ rect! ;
	
#tlist t0 t1 t2 t3
	
:decodecave | cave --
	>a
	0 'randseed1 !
	4 ]acave $ff and 'randseed2 ! | + dificult
	'cave 7 40 22 * cfill
	3 ( 23 <=? 
		0 ( 39 <=?
			nextRandom
			1								| obj
			0 ( 3 <=?						| obj cnt
				randseed1 					| obj cnt rnd
				over $1c + ]acave <? ( 		| obj cnt rnd
					rot drop 				| cnt rnd
					over $18 + ]acave -rot	| obj cnt rnd
					) drop
				1+ ) drop	| y x obj
			over pick3 cave!
			1+ ) drop
		1+ ) drop
	$20 a+
	( ca@+ -1 <>?
		dup $3f and 
		swap 6 >> 3 and 3 << 'tlist + @ ex
		) drop 
	$7 0 2 40 22 rect!
	;
	
::decodecavenow	| ncave --
	3 << 'cavetab + @ decodecave ;
	

|------------ SHOW
#tchars " .wmof*W<<<<>>>>OOoo^^vv                                                "
:.ec
	|$3f and 'tchars + c@ .emit
	"%h " .print
	;

::showsb
	'cave 80 + >a
	1 ( 23 <? 1+
		dup "%d " .print
		.sp
		40 ( 1? 1-
			ca@+ .ec
			) drop
		.cr
		) drop ;